VK_ACCESS_TOKEN=your-community-token
# Optional; defaults to 232664735
# VK_GROUP_ID=232664735
# Optional peer ID of the support conversation; if omitted/unavailable, tickets go to BOT_ADMIN_IDS.
# SUPPORT_CHAT_PEER_ID=2000000036
# Comma-separated VK user IDs allowed to use /sql (default: 778382713)
BOT_ADMIN_IDS=778382713
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mintchatmanager
POSTGRES_USER=mintbot
POSTGRES_PASSWORD=replace-with-a-strong-password
